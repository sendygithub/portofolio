generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Apb {
  id        Int    @id @default(autoincrement())
  apb       String
  noSpek    String @map("no_spek")
  sudut     String @default("")
  lebar     String @default("")
  toleransi String @default("")

  @@map("apb")
}
